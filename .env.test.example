# Base de datos de test: PostgreSQL local de docker-compose.yml. Nunca Supabase.
DATABASE_URL=postgresql://cv:cv@localhost:5433/cv_generator_test
DIRECT_URL=postgresql://cv:cv@localhost:5433/cv_generator_test

JWT_ACCESS_SECRET=test-access-secret-at-least-32-characters-long
