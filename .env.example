# ---------------------------------------------------------------------------
# Base de datos (Supabase)
# Supabase Dashboard > Project Settings > Database > Connection string
# Reemplaza <project-ref>, <password> y <region> con los datos de tu proyecto.
# ---------------------------------------------------------------------------

# Pooler en modo transacción (puerto 6543): lo usa la API en ejecución.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true

# Pooler en modo sesión (puerto 5432): lo usa Prisma CLI (migrate, db seed).
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------------------
# Autenticación
# Genera secretos largos y aleatorios, p. ej.:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---------------------------------------------------------------------------
# Servidor
# ---------------------------------------------------------------------------
CORS_ORIGIN=http://localhost:4200
PORT=3000

# ---------------------------------------------------------------------------
# Producción (opcionales; ver docs/DEPLOY.md)
# ---------------------------------------------------------------------------
# Proxies delante de la API (Netlify + Render = 2). 0 en local.
TRUST_PROXY=0
# PDFs generados a la vez (1 en instancias de 512 MB).
PDF_MAX_CONCURRENT=2
# Desactiva el sandbox de Chromium solo en plataformas que no lo permiten (Render).
PDF_DISABLE_SANDBOX=false
